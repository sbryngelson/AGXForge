  "neighbour": "#include <metal_stdlib>\nusing namespace metal;\nstruct Px { uint a; uint b; };\nkernel void ibk(device uint *u [[buffer(0)]], device uint *f [[buffer(1)]], device uint *h [[buffer(2)]],\n                imageblock<Px, imageblock_layout_explicit> ib,\n                ushort2 tid [[thread_position_in_threadgroup]]) {\n  threadgroup_imageblock Px *p = ib.data(ushort2((tid.x + 1) % 32, 0));\n  p->a = uint(tid.x) * 3u + 1u;\n  p->b = 0u;\n  threadgroup_barrier(mem_flags::mem_threadgroup_imageblock);\n  u[tid.x] = ib.data(tid)->a;\n  f[tid.x] = 7u;\n}\n",
  "own": "#include <metal_stdlib>\nusing namespace metal;\nstruct Px { uint a; uint b; };\nkernel void ibk(device uint *u [[buffer(0)]], device uint *f [[buffer(1)]], device uint *h [[buffer(2)]],\n                imageblock<Px, imageblock_layout_explicit> ib,\n                ushort2 tid [[thread_position_in_threadgroup]]) {\n  threadgroup_imageblock Px *p = ib.data(tid);\n  p->a = uint(tid.x) * 3u + 1u;\n  p->b = 0u;\n  threadgroup_barrier(mem_flags::mem_threadgroup_imageblock);\n  u[tid.x] = ib.data(tid)->a;\n  f[tid.x] = 7u;\n}\n"
